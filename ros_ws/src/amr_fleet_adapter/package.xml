<?xml version="1.0"?>
<package format="3">
  <name>amr_fleet_adapter</name>
  <version>0.1.0</version>
  <description>ROS 2 adapter exposing the AMR fleet domain core through actions, services and telemetry topics.</description>
  <maintainer email="maintainers@example.com">AMR Fleet Integration Stack Contributors</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>amr_fleet_core</exec_depend>
  <exec_depend>amr_interfaces</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
