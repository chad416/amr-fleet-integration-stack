<?xml version="1.0"?>
<sdf version="1.10">
  <world name="amr_factory">
    <physics name="deterministic_1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <gravity>0 0 -9.81</gravity>
    <magnetic_field>6.0e-6 2.3e-5 -4.2e-5</magnetic_field>
    <atmosphere type="adiabatic"/>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.08 0.09 0.12 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="factory_sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -1.0</direction>
    </light>

    <model name="factory_floor">
      <static>true</static>
      <link name="floor_link">
        <collision name="floor_collision">
          <geometry><box><size>12 8 0.1</size></box></geometry>
        </collision>
        <visual name="floor_visual">
          <geometry><box><size>12 8 0.1</size></box></geometry>
          <material>
            <ambient>0.32 0.34 0.36 1</ambient>
            <diffuse>0.42 0.44 0.46 1</diffuse>
            <pbr><metal><roughness>0.85</roughness><metalness>0.05</metalness></metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <model name="north_wall">
      <static>true</static><pose>0 4 0.75 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision"><geometry><box><size>12 0.15 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12 0.15 1.5</size></box></geometry><material><diffuse>0.65 0.68 0.72 1</diffuse></material></visual>
      </link>
    </model>
    <model name="south_wall">
      <static>true</static><pose>0 -4 0.75 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision"><geometry><box><size>12 0.15 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12 0.15 1.5</size></box></geometry><material><diffuse>0.65 0.68 0.72 1</diffuse></material></visual>
      </link>
    </model>
    <model name="east_wall">
      <static>true</static><pose>6 0 0.75 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision"><geometry><box><size>0.15 8 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 8 1.5</size></box></geometry><material><diffuse>0.65 0.68 0.72 1</diffuse></material></visual>
      </link>
    </model>
    <model name="west_wall">
      <static>true</static><pose>-6 0 0.75 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision"><geometry><box><size>0.15 8 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 8 1.5</size></box></geometry><material><diffuse>0.65 0.68 0.72 1</diffuse></material></visual>
      </link>
    </model>

    <model name="central_rack">
      <static>true</static><pose>0 0.9 0.75 0 0 0</pose>
      <link name="rack_link">
        <collision name="collision"><geometry><box><size>2.4 0.7 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.4 0.7 1.5</size></box></geometry><material><diffuse>0.16 0.24 0.34 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pallet_obstacle">
      <static>true</static><pose>1.8 -1.4 0.18 0 0 0.25</pose>
      <link name="pallet_link">
        <collision name="collision"><geometry><box><size>1.0 0.8 0.36</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.0 0.8 0.36</size></box></geometry><material><diffuse>0.52 0.30 0.12 1</diffuse></material></visual>
      </link>
    </model>

    <model name="station_infeed">
      <static>true</static><pose>4.9 2.7 0.12 0 0 0</pose>
      <link name="station_link">
        <collision name="collision"><geometry><box><size>1.2 1.2 0.24</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.2 1.2 0.24</size></box></geometry><material><diffuse>0.10 0.65 0.25 1</diffuse></material></visual>
      </link>
    </model>
    <model name="station_outfeed">
      <static>true</static><pose>4.9 -2.7 0.12 0 0 0</pose>
      <link name="station_link">
        <collision name="collision"><geometry><box><size>1.2 1.2 0.24</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.2 1.2 0.24</size></box></geometry><material><diffuse>0.95 0.55 0.05 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
